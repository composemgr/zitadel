# Zitadel - app.env.sample
# Copy to app.env and adjust values before starting

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# Database credentials
DB_CREATE_DATABASE_NAME=zitadel
DB_USER_NAME=zitadel
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# Master key for encryption (exactly 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# First admin user
APP_ADMIN_USER=administrator
APP_ADMIN_PASS=changeme_admin_password
