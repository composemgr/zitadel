# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=zitadel.example.com

APP_ORG_NAME=Zitadel

# Database, DB_USER_NAME is the role Zitadel creates for itself, DB_ADMIN_NAME
# is the Postgres superuser it connects as to run the migrations
DB_CREATE_DATABASE_NAME=zitadel
DB_USER_NAME=zitadel
DB_USER_PASS=replace-with-a-random-password
DB_ADMIN_NAME=postgres
DB_ADMIN_PASS=replace-with-a-random-password

# Master key used to encrypt secrets, must be exactly 32 characters
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# First instance organization admin
APP_ADMIN_USER=administrator
APP_ADMIN_PASS=replace-with-a-random-password

# The port clients use to reach the login, 443 behind a reverse proxy
ZITADEL_EXTERNAL_PORT=443

# Set to false only when the login is reached over plain HTTP
ZITADEL_EXTERNAL_SECURE=true
